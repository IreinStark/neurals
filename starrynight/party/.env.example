# Local development: `npm run dev` already passes ALLOW_DEV_AUTH=true, so no .env is needed.
# In dev, anyone may join and the role comes from ?role=owner|editor|viewer. NEVER set this in production.
ALLOW_DEV_AUTH=true

# Production / when Supabase is ready (docs/ARCHITECTURE_SPEC.md §5):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service-role-key        # server-only secret
# SUPABASE_JWT_SECRET=legacy-hs256-secret           # only for projects still on the legacy JWT secret
